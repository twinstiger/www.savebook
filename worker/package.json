{
  "name": "savebook-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker backend for SaveBook - handles web scraping, conversion, R2 storage, and D1 persistence",
  "main": "index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute savebook-db --file=../schema.sql",
    "r2:create": "wrangler r2 bucket create savebook-files",
    "secret:smtp-user": "wrangler secret put KINDLE_SMTP_USER",
    "secret:smtp-pass": "wrangler secret put KINDLE_SMTP_PASS"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.2.10",
    "@fontsource/roboto": "^5.2.10",
    "@mozilla/readability": "^0.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
